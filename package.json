{
	"name": "hono-drizzle-gotrue",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:generate": "bunx drizzle-kit generate",
		"db:pull": "bunx drizzle-kit pull",
		"db:push": "bunx drizzle-kit push",
		"db:seed": "bun ./src/db/seed.ts",
		"db:reset": "bash ./src/cli/reset-db.sh",
		"db:prepare": "bun run ./src/db/prepare.ts && bun run db:generate && bun run db:migrate",
		"start": "docker compose up -d",
		"start:force": "docker compose up -d --force-recreate",
		"stop": "docker compose down",
		"stop:reset": "docker compose down -v"
	},
	"dependencies": {
		"@hono/arktype-validator": "^2.0.1",
		"arktype": "^2.2.7",
		"hono": "^4.13.13",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "latest",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc"
	}
}
